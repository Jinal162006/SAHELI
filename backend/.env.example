# Copy to .env for local development. In production, set these in your host's secret store.

SAHELI_ENV=development              # production | development
SAHELI_PUBLIC_URL=http://localhost:5173
SAHELI_CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost

# Supabase Postgres connection string (Session pooler or direct connection).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/saheli

# Supabase project settings (Project Settings > API).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                 # publishable key, safe for the browser
SUPABASE_SERVICE_KEY=              # secret key, server only (account deletion, storage)
SUPABASE_JWT_SECRET=               # only for legacy HS256 projects and the local auth emulator
SAHELI_STORAGE_BUCKET=evidence     # a PRIVATE bucket
SAHELI_STORAGE_BACKEND=local       # supabase in production

# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SAHELI_ENCRYPTION_KEY=
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SAHELI_HASH_SECRET=

# Optional. Without it, every check still runs on SAHELI's pattern rules.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SAHELI_LLM_PROVIDER=auto
SAHELI_LLM_MODEL=gemini-3-flash-preview

# Optional integrations
GOOGLE_SAFE_BROWSING_API_KEY=
RESEND_API_KEY=
SAHELI_EMAIL_FROM=                 # e.g. SAHELI <alerts@your-domain>

# Who operates this deployment (shown on the Privacy, Terms and Contact pages).
SAHELI_OPERATOR_NAME=
SAHELI_SUPPORT_EMAIL=
SAHELI_GOVERNING_LAW=              # e.g. India
